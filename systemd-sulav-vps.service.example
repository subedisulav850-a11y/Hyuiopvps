[Unit]
Description=Sulav VPS control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sulav
WorkingDirectory=/opt/sulav-vps
EnvironmentFile=/opt/sulav-vps/.env
ExecStart=/opt/sulav-vps/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 5000 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/sulav-vps

[Install]
WantedBy=multi-user.target
